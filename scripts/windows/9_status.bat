@echo off
cd /d F:\Coding\Research
powershell -NoProfile -Command "$o = Get-CimInstance Win32_OperatingSystem; $c = Get-PSDrive C; 'C: free GB: ' + [math]::Round($c.Free/1GB,2); 'RAM total GB: ' + [math]::Round($o.TotalVisibleMemorySize/1MB,1); 'RAM free GB: ' + [math]::Round($o.FreePhysicalMemory/1MB,1); 'Commit limit GB: ' + [math]::Round($o.TotalVirtualMemorySize/1MB,1); 'Commit free GB: ' + [math]::Round($o.FreeVirtualMemory/1MB,1); Get-CimInstance Win32_PageFileUsage | ForEach-Object { 'Pagefile ' + $_.Name + ' allocated MB: ' + $_.AllocatedBaseSize + ', in use MB: ' + $_.CurrentUsage }; 'Top memory users (MB):'; Get-Process | Sort-Object PagedMemorySize64 -Descending | Select-Object -First 8 | ForEach-Object { '  ' + $_.ProcessName + ' ' + [math]::Round($_.PagedMemorySize64/1MB) }" > logs_status.txt 2>&1
